<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="5dp"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/fieldName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="5dp"
            android:text="@string/identifiers"
            android:textSize="16sp" />

        <Button
            android:id="@+id/readBtn"
            style="@style/Widget.Material3.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="11dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="0"
            android:padding="5dp"
            android:text="@string/read" />

        <Button
            android:id="@+id/writeBtn"
            style="@style/Widget.Material3.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="11dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="0"
            android:padding="5dp"
            android:text="@string/read"
            android:visibility="gone" />
    </LinearLayout>

    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/valueField"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:editable="false"
        android:hint="@android:string/unknownName"
        android:maxLength="128"
        android:maxLines="1"
        android:textIsSelectable="true" />

    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/naviId"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:editable="false"
        android:hint="@string/navi_id"
        android:maxLength="128"
        android:maxLines="1"
        android:textIsSelectable="true" />

    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/tcuId"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:editable="false"
        android:hint="@string/tcu_id"
        android:maxLength="128"
        android:maxLines="1"
        android:textIsSelectable="true" />

    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/simId"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:editable="false"
        android:hint="@string/sim_id"
        android:maxLength="128"
        android:maxLines="1"
        android:textIsSelectable="true" />

    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/msn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:editable="false"
        android:hint="@string/msn"
        android:maxLength="128"
        android:maxLines="1"
        android:textIsSelectable="true" />

    <View
        android:id="@+id/divider2"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="4dp"
        android:background="?android:attr/listDivider" />
</LinearLayout>